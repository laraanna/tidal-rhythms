---
import Layout from '../../layouts/Layout.astro';
import OfferPage from '../../components/OfferPage.astro';
import Footer from '../../components/Footer.astro';
import { getOffer, offers } from '../../data/offers';
import therapyLeft from '../../images/dmt_hero_1.jpg';
import therapyRight from '../../images/dmt_hero_2.jpg';
import somaticsLeft from '../../images/sad_hero_1.jpg';
import somaticsRight from '../../images/sad_hero_2.jpg';
import yogaLeft from '../../images/sy_hero_1.jpg';
import yogaRight from '../../images/sy_hero_2.jpg';
import bgA from '../../images/bg_option_A.jpg';
import bgB from '../../images/bg_option_B.jpg';
import bgC from '../../images/bg_option_C.jpg';

const photos = {
  'dance-movement-therapy': { left: therapyLeft, right: therapyRight, bg: bgA },
  'somatics-dance': { left: somaticsLeft, right: somaticsRight, bg: bgB },
  'somatic-yoga': { left: yogaLeft, right: yogaRight, bg: bgC },
} as const;

export function getStaticPaths() {
  return offers.map((offer) => ({ params: { slug: offer.slug } }));
}

const offer = getOffer(Astro.params.slug ?? '');

if (!offer) {
  throw new Error(`Unknown offer: ${Astro.params.slug}`);
}

const pair = photos[offer.slug];
---

<Layout titleKey={`offers.${offer.key}.metaTitle`} showContact={false}>
  <OfferPage offer={offer} photoLeft={pair.left} photoRight={pair.right} bg={pair.bg} />
  <Footer />
</Layout>
