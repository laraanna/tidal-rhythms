---
import { Image } from 'astro:assets';
import { t } from '../i18n';
import type { Offer } from '../data/offers';
import type { ImageMetadata } from 'astro';
import CalendlyEmbed from './CalendlyEmbed.astro';
import faqPhoto from '../images/qa_hero.jpg';

interface Props {
  offer: Offer;
  photoLeft: ImageMetadata;
  photoRight: ImageMetadata;
  bg: ImageMetadata;
}

const { offer, photoLeft, photoRight, bg } = Astro.props;
const prefix = `offers.${offer.key}`;

const pillars = [
  { label: 'offers.pillarSomatic', body: 'offers.pillarSomaticBody' },
  {
    label: 'offers.pillarRelational',
    body: offer.key === 'somatics' ? 'offers.somatics.pillarRelationalBody' : 'offers.pillarRelationalBody',
  },
  { label: 'offers.pillarAgency', body: 'offers.pillarAgencyBody' },
  {
    label: 'offers.pillarContextual',
    body: offer.key === 'somatics' ? 'offers.somatics.pillarContextualBody' : 'offers.pillarContextualBody',
  },
  ...(offer.key === 'somatics'
    ? []
    : [
        {
          label: 'offers.pillarSlow',
          body: offer.key === 'therapy' ? 'offers.therapy.pillarSlowBody' : 'offers.pillarSlowBody',
        },
      ]),
];

const defaultSteps = [
  { label: 'offers.sessionArrive', body: 'offers.sessionArriveBody', color: offer.sessionColors[0] },
  { label: 'offers.sessionExplore', body: 'offers.sessionExploreBody', color: offer.sessionColors[1] },
  { label: 'offers.sessionIntegrate', body: 'offers.sessionIntegrateBody', color: offer.sessionColors[2] },
] as const;

const somaticsSteps = [
  { label: 'offers.somatics.stage1', body: 'offers.somatics.stage1Body' },
  { label: 'offers.somatics.stage2', body: 'offers.somatics.stage2Body' },
  { label: 'offers.somatics.stage3', body: 'offers.somatics.stage3Body' },
  { label: 'offers.somatics.stage4', body: 'offers.somatics.stage4Body' },
  { label: 'offers.somatics.stage5', body: 'offers.somatics.stage5Body' },
] as const;

const yogaSteps = [
  { label: 'offers.yoga.stage1', body: 'offers.yoga.stage1Body' },
  { label: 'offers.yoga.stage2', body: 'offers.yoga.stage2Body' },
  { label: 'offers.yoga.stage3', body: 'offers.yoga.stage3Body' },
  { label: 'offers.yoga.stage4', body: 'offers.yoga.stage4Body' },
] as const;

const steps =
  offer.key === 'somatics'
    ? somaticsSteps.map((step, index) => ({ ...step, color: offer.sessionColors[index] }))
    : offer.key === 'yoga'
      ? yogaSteps.map((step, index) => ({ ...step, color: offer.sessionColors[index] }))
      : defaultSteps;

const sessionIntroKey = offer.key === 'somatics' ? `${prefix}.sessionIntro` : offer.key === 'yoga' ? null : 'offers.sessionIntro';

const faqs = [
  { q: 'faq.q1', a: 'faq.a1' },
  { q: 'faq.q2', a: 'faq.a2' },
  { q: 'faq.q3', a: 'faq.a3' },
  { q: 'faq.q4', a: 'faq.a4' },
  { q: 'faq.q5', a: 'faq.a5' },
] as const;
---

<article class="bg-[#DDDDD3] text-charcoal">
  <header class="flex items-start justify-between px-6 pt-7 lg:px-10 lg:pt-8">
    <a href="/" class="text-charcoal">
      <span
        class="block font-founders text-[28px] leading-none font-normal tracking-[0.3em] uppercase md:text-[36px]"
        data-i18n="hero.logoTidal"
      >
        {t('hero.logoTidal')}
      </span>
      <span
        class="block font-founders text-[17px] leading-none font-light tracking-[0.3em] uppercase md:text-[22px]"
        data-i18n="hero.logoRhythms"
      >
        {t('hero.logoRhythms')}
      </span>
    </a>
    <button
      type="button"
      class="font-nunito text-charcoal mt-1 flex items-center gap-2 text-sm tracking-[0.3em] uppercase lg:text-xl"
      data-menu-open
      data-i18n-aria-label="hero.menuAria"
      aria-label={t('hero.menuAria')}
    >
      <span class="size-3 rounded-full bg-charcoal lg:size-3.5"></span>
      <span data-i18n="hero.menu">{t('hero.menu')}</span>
    </button>
  </header>

  <section class="pt-16 pb-20 md:pt-24 lg:pt-28 lg:pb-28">
    <div class="flex items-start" data-fade-in>
      <span class="relative size-12 shrink-0 overflow-hidden sm:size-16 md:size-20">
        <Image src={bg} alt="" widths={[160, 240]} sizes="5rem" class="absolute inset-0 size-full object-cover" aria-hidden="true" />
        <span class="absolute inset-0 bg-charcoal/10" aria-hidden="true"></span>
      </span>
      <div class="min-w-0 flex-1 px-6 md:px-10 lg:px-12">
        <h1 class="font-founders text-step-6 leading-[1.1] font-light md:text-step-8" data-i18n={`${prefix}.pageTitle`}>
          {t(`${prefix}.pageTitle`)}
        </h1>
        <p
          class="font-founders mt-4 text-step-0 font-light tracking-[0.22em] uppercase md:text-step-1"
          data-i18n={`${prefix}.blurb`}
        >
          {t(`${prefix}.blurb`)}
        </p>
      </div>
    </div>

    <div class="mx-auto mt-16 grid max-w-[92rem] items-start gap-12 px-8 md:px-16 lg:mt-24 lg:grid-cols-[1fr_minmax(16rem,22rem)] lg:gap-16 lg:px-20">
        <div data-fade-in style="--fade-delay: 80ms">
          <p class="font-founders text-step-2 font-light italic md:text-step-3" data-i18n={`${prefix}.introLead`}>
            {t(`${prefix}.introLead`)}
          </p>
          <p
            class="font-nunito mt-4 max-w-[36rem] text-step--1 leading-[1.7] font-light md:text-step-0"
            data-i18n={`${prefix}.introBody`}
          >
            {t(`${prefix}.introBody`)}
          </p>
          <a
            href="#reserve"
            class="font-nunito mt-10 inline-flex border border-charcoal px-10 py-3.5 text-step--1 font-light tracking-[0.32em] uppercase"
            data-i18n="offers.bookCta"
          >
            {t('offers.bookCta')}
          </a>
        </div>

        <aside class="bg-[#FFFFFF]/60 px-8 py-8 md:px-10 md:py-10" data-fade-in style="--fade-delay: 140ms">
          <h2
            class="font-founders text-step--1 font-medium tracking-[0.18em] uppercase"
            data-i18n="offers.detailsTitle"
          >
            {t('offers.detailsTitle')}
          </h2>
          <dl class="font-nunito mt-5 space-y-1 text-step--1 font-light leading-[1.7]">
            <div>
              <dt class="inline" data-i18n="offers.detailsFormatLabel">{t('offers.detailsFormatLabel')}</dt>
              <span>: </span>
              <dd class="inline" data-i18n={`${prefix}.detailsFormat`}>{t(`${prefix}.detailsFormat`)}</dd>
            </div>
            <div>
              <dt class="inline" data-i18n="offers.detailsLocationLabel">{t('offers.detailsLocationLabel')}</dt>
              <span>: </span>
              <dd class="inline" data-i18n={`${prefix}.detailsLocation`}>{t(`${prefix}.detailsLocation`)}</dd>
            </div>
            <div>
              <dt class="inline" data-i18n="offers.detailsPriceLabel">{t('offers.detailsPriceLabel')}</dt>
              <span>: </span>
              <dd class="inline" data-i18n={`${prefix}.detailsPrice`}>{t(`${prefix}.detailsPrice`)}</dd>
            </div>
          </dl>
        </aside>
    </div>
  </section>

  <section class="relative overflow-hidden px-8 py-4xl text-center md:px-16 md:py-5xl lg:px-20">
    <Image
      src={bg}
      alt=""
      widths={[1200, 1800, 2400]}
      sizes="100vw"
      class="absolute inset-0 size-full object-cover"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-charcoal/10" aria-hidden="true"></div>
    <p
      class="font-cormorant relative z-10 mx-auto max-w-[22em] text-step-3 leading-[1.35] font-light text-paper md:text-step-5"
      data-i18n={`${prefix}.quote`}
    >
      {t(`${prefix}.quote`)}
    </p>
  </section>

  <section class="grid overflow-hidden md:grid-cols-2">
    <Image
      src={photoLeft}
      alt={t(`${prefix}.photoLeftAlt`)}
      data-i18n-alt={`${prefix}.photoLeftAlt`}
      widths={[720, 1100, 1600]}
      sizes="(min-width: 768px) 50vw, 100vw"
      class="aspect-[4/5] h-full w-full object-cover md:aspect-auto md:h-[85vh]"
    />
    <Image
      src={photoRight}
      alt={t(`${prefix}.photoRightAlt`)}
      data-i18n-alt={`${prefix}.photoRightAlt`}
      widths={[720, 1100, 1600]}
      sizes="(min-width: 768px) 50vw, 100vw"
      class="hidden aspect-[4/5] h-full w-full object-cover md:block md:aspect-auto md:h-[85vh]"
    />
  </section>

  <section class="px-8 pt-20 pb-8 md:px-16 md:py-28 lg:px-20 lg:py-32">
    <div class="mx-auto max-w-[92rem]">
      <h2 class="font-founders text-step-6 font-light md:text-step-8" data-i18n="offers.approachTitle" data-fade-in>
        {t('offers.approachTitle')}
      </h2>
      {
        offer.key === 'yoga' ? (
          <div
            class="font-founders mt-4 max-w-[36em] text-step-1 font-light italic md:text-step-3 [&_p+p]:mt-4 [&_a]:underline [&_a]:underline-offset-[0.18em]"
            data-i18n-html={`${prefix}.approachIntro`}
            data-fade-in
            set:html={t(`${prefix}.approachIntro`)}
          />
        ) : (
          <p
            class="font-founders mt-4 max-w-[36em] text-step-1 font-light whitespace-pre-line md:text-step-3"
            data-i18n={`${prefix}.approachIntro`}
            data-fade-in
          >
            {t(`${prefix}.approachIntro`)}
          </p>
        )
      }

      {
        offer.key !== 'yoga' && (
      <div class="mt-16 flex flex-col gap-10 md:mt-20 md:gap-12">
        {
          pillars.map((pillar, index) => (
            <div
              class="grid items-start gap-4 md:grid-cols-[minmax(12rem,28%)_1fr] md:gap-12 lg:grid-cols-[minmax(14rem,32%)_1fr]"
              data-fade-in
              style={`--fade-delay: ${index * 60}ms`}
            >
              <div class="flex items-center gap-5">
                <span class="hidden h-px flex-1 bg-charcoal/50 md:block"></span>
                <p
                  class="font-nunito w-full text-left text-step--1 leading-tight font-light tracking-[0.28em] uppercase md:w-auto md:shrink-0 md:text-right"
                  data-i18n-html={pillar.label}
                  set:html={t(pillar.label)}
                />
              </div>
              <p class="font-nunito max-w-[38rem] text-step--1 leading-[1.7] font-light" data-i18n={pillar.body}>
                {t(pillar.body)}
              </p>
            </div>
          ))
        }
      </div>
        )
      }

      <div class="mt-24 md:mt-32 md:grid md:grid-cols-[minmax(12rem,28%)_1fr] md:gap-12 lg:grid-cols-[minmax(14rem,32%)_1fr]">
        <div class="hidden md:block"></div>
        <div data-fade-in>
          <h2 class="font-founders text-step-6 leading-[1.1] font-light md:text-step-8" data-i18n="offers.sessionTitle">
            {t('offers.sessionTitle')}
          </h2>
          {
            sessionIntroKey && (
              <p
                class="font-founders mt-4 max-w-[32em] text-step-1 font-light italic md:text-step-3"
                data-i18n={sessionIntroKey}
              >
                {t(sessionIntroKey)}
              </p>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section class="pb-24 md:pb-32">
    <div class="flex flex-col gap-2">
      {
        steps.map((step) => (
          <div class="grid grid-cols-[minmax(6.5rem,38%)_1fr] items-center">
            <p
              class="font-nunito flex min-h-16 items-center justify-end px-3 py-3 text-right text-[10px] leading-tight font-light tracking-[0.18em] text-charcoal uppercase md:min-h-20 md:px-8 md:text-step--1 md:tracking-[0.4em]"
              style={`background: ${step.color}`}
              data-i18n={step.label}
            >
              {t(step.label)}
            </p>
            <div class="flex items-center gap-3 px-4 py-3 md:gap-6 md:px-10 md:py-5">
              <span class="hidden h-px w-8 shrink-0 bg-charcoal/35 sm:block md:w-16"></span>
              <p class="font-nunito max-w-[36rem] text-step--2 leading-[1.65] font-light md:text-step--1" data-i18n={step.body}>
                {t(step.body)}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  {
    (offer.key === 'somatics' || offer.key === 'yoga') && (
      <section class="px-8 pb-10 md:px-16 md:pb-32 lg:px-20">
        <div class="mx-auto max-w-[92rem]" data-fade-in>
          <h2
            class="font-founders text-step-6 leading-[1.1] font-light md:text-step-8"
            data-i18n={`${prefix}.whoTitle`}
          >
            {t(`${prefix}.whoTitle`)}
          </h2>
          <p
            class="font-founders mt-2 max-w-[40em] text-step-1 font-light italic md:mt-4 md:text-step-3"
            data-i18n={`${prefix}.whoBody`}
          >
            {t(`${prefix}.whoBody`)}
          </p>
        </div>
      </section>
    )
  }

  <section id="reserve" class="px-8 pt-12 pb-24 md:px-16 md:pt-4xl md:pb-32 lg:px-20">
    <h2
      class="font-founders text-center text-step-6 font-light md:text-step-8"
      data-i18n="offers.reserveTitle"
    >
      {t('offers.reserveTitle')}
    </h2>
    <div class="mt-l">
      <CalendlyEmbed url={offer.calendly} label={t('rdv.embedTitle')} />
    </div>
  </section>

  {
    offer.key !== 'yoga' && (
  <section class="grid md:grid-cols-2">
    <Image
      src={faqPhoto}
      alt={t('faq.photoAlt')}
      data-i18n-alt="faq.photoAlt"
      widths={[720, 1100, 1600]}
      sizes="(min-width: 768px) 50vw, 100vw"
      class="aspect-[4/5] h-full w-full object-cover md:aspect-auto md:min-h-[85vh]"
    />
    <div class="bg-[#575757] text-paper flex flex-col justify-center px-8 py-16 md:px-12 md:py-20 lg:px-16">
      <h2
        class="font-founders text-step-6 font-light md:text-step-7"
        data-i18n="faq.title"
      >
        {t('faq.title')}
      </h2>
      <div class="mt-10">
        {
          faqs.map((item) => (
            <details class="faq-item">
              <summary>
                <span data-i18n={item.q}>{t(item.q)}</span>
              </summary>
              <p
                class="font-nunito pt-1 pb-5 text-[max(12px,var(--step--1))] leading-[1.65] font-light text-paper/85"
                data-i18n={item.a}
              >
                {t(item.a)}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
    )
  }
</article>

<style>
  .faq-item {
    border-bottom: 1px solid rgb(254 254 254 / 0.28);
  }

  .faq-item summary {
    display: flex;
    cursor: pointer;
    list-style: none;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.15rem 0;
    font-family: var(--font-nunito);
    font-size: max(12px, var(--step--2));
    font-weight: 300;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1.45;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: '+';
    flex-shrink: 0;
    font-size: 1.1em;
    line-height: 1;
  }

  .faq-item[open] summary::after {
    content: '−';
  }
</style>
