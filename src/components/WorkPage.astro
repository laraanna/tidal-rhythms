---
import { Image } from 'astro:assets';
import { t } from '../i18n';
import type { ImageMetadata } from 'astro';
import CalendlyEmbed from './CalendlyEmbed.astro';

interface Props {
  photoLeft: ImageMetadata;
  photoRight: ImageMetadata;
}

const { photoLeft, photoRight } = Astro.props;

const benefits = [
  { label: 'work.benefit1', body: 'work.benefit1Body' },
  { label: 'work.benefit2', body: 'work.benefit2Body' },
  { label: 'work.benefit3', body: 'work.benefit3Body' },
  { label: 'work.benefit4', body: 'work.benefit4Body' },
] as const;

const formats = [
  { label: 'work.format1', body: 'work.format1Body' },
  { label: 'work.format2', body: 'work.format2Body' },
  { label: 'work.format3', body: 'work.format3Body' },
  { label: 'work.format4', body: 'work.format4Body' },
] as const;

const steps = [
  { label: 'work.stage1', body: 'work.stage1Body', color: '#C5C8BE' },
  { label: 'work.stage2', body: 'work.stage2Body', color: '#B0B4A8' },
  { label: 'work.stage3', body: 'work.stage3Body', color: '#9BA08F' },
  { label: 'work.stage4', body: 'work.stage4Body', color: '#7A7E70' },
] as const;

const calendly = 'https://calendly.com/mayosmith-mytam/introduction-call';
const contactEmail = t('work.detailsContact');
---

<article class="bg-[#DDDDD3] text-charcoal">
  <header class="flex items-start justify-between px-6 pt-7 lg:px-10 lg:pt-8">
    <a href="/" class="text-charcoal">
      <span
        class="block font-founders text-[28px] leading-none font-normal tracking-[0.3em] uppercase md:text-[36px]"
        data-i18n="hero.logoTidal"
      >
        {t('hero.logoTidal')}
      </span>
      <span
        class="block font-founders text-[17px] leading-none font-light tracking-[0.3em] uppercase md:text-[22px]"
        data-i18n="hero.logoRhythms"
      >
        {t('hero.logoRhythms')}
      </span>
    </a>
    <button
      type="button"
      class="font-nunito text-charcoal mt-1 flex items-center gap-2 text-sm tracking-[0.3em] uppercase lg:text-xl"
      data-menu-open
      data-i18n-aria-label="hero.menuAria"
      aria-label={t('hero.menuAria')}
    >
      <span class="size-3 rounded-full bg-charcoal lg:size-3.5"></span>
      <span data-i18n="hero.menu">{t('hero.menu')}</span>
    </button>
  </header>

  <section class="pt-16 pb-20 md:pt-24 lg:pt-28 lg:pb-28">
    <div class="flex items-start" data-fade-in>
      <span class="size-12 shrink-0 bg-olive sm:size-16 md:size-20"></span>
      <div class="min-w-0 flex-1 px-6 md:px-10 lg:px-12">
        <h1 class="font-founders text-step-6 leading-[1.1] font-light md:text-step-8" data-i18n="work.title">
          {t('work.title')}
        </h1>
      </div>
    </div>

    <div class="mx-auto mt-16 grid max-w-[92rem] items-start gap-12 px-8 md:px-16 lg:mt-24 lg:grid-cols-[1fr_minmax(16rem,22rem)] lg:gap-16 lg:px-20">
      <div data-fade-in style="--fade-delay: 80ms">
        <p
          class="font-nunito max-w-[36rem] text-step--1 leading-[1.7] font-light md:text-step-0"
          data-i18n="work.body"
        >
          {t('work.body')}
        </p>
        <a
          href="#reserve"
          class="font-nunito mt-10 inline-flex border border-charcoal px-10 py-3.5 text-step--1 font-light tracking-[0.32em] uppercase"
          data-i18n="work.bookCta"
        >
          {t('work.bookCta')}
        </a>
      </div>

      <aside class="bg-[#E7E7E7]/60 px-8 py-8 md:px-10 md:py-10" data-fade-in style="--fade-delay: 140ms">
        <h2
          class="font-founders text-step--1 font-medium tracking-[0.18em] uppercase"
          data-i18n="work.detailsTitle"
        >
          {t('work.detailsTitle')}
        </h2>
        <dl class="font-nunito mt-5 space-y-1 text-step--1 font-light leading-[1.7]">
          <div>
            <dt class="inline" data-i18n="work.detailsBasedLabel">{t('work.detailsBasedLabel')}</dt>
            <span>: </span>
            <dd class="inline" data-i18n="work.detailsBased">{t('work.detailsBased')}</dd>
          </div>
          <div>
            <dt class="inline" data-i18n="work.detailsDeliveryLabel">{t('work.detailsDeliveryLabel')}</dt>
            <span>: </span>
            <dd class="inline" data-i18n="work.detailsDelivery">{t('work.detailsDelivery')}</dd>
          </div>
          <div>
            <dt class="inline" data-i18n="work.detailsContactLabel">{t('work.detailsContactLabel')}</dt>
            <span>: </span>
            <dd class="inline">
              <a class="underline underline-offset-[0.18em]" href={`mailto:${contactEmail}`} data-i18n="work.detailsContact">
                {contactEmail}
              </a>
            </dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="bg-olive relative overflow-hidden px-8 py-4xl text-center md:px-16 md:py-5xl lg:px-20">
    <p
      class="font-founders relative z-10 text-step--1 font-medium tracking-[0.18em] text-paper uppercase"
      data-i18n="work.quoteLabel"
    >
      {t('work.quoteLabel')}
    </p>
    <p
      class="font-cormorant relative z-10 mx-auto mt-6 max-w-[24em] text-step-3 leading-[1.35] font-light text-paper md:text-step-5"
      data-i18n="work.quote"
    >
      {t('work.quote')}
    </p>
  </section>

  <section class="relative z-0 grid overflow-hidden md:grid-cols-2">
    <Image
      src={photoLeft}
      alt={t('work.photoLeftAlt')}
      data-i18n-alt="work.photoLeftAlt"
      widths={[720, 1100, 1600]}
      sizes="(min-width: 768px) 50vw, 100vw"
      class="aspect-[4/5] h-full w-full object-cover md:aspect-auto md:h-[85vh]"
    />
    <Image
      src={photoRight}
      alt={t('work.photoRightAlt')}
      data-i18n-alt="work.photoRightAlt"
      widths={[720, 1100, 1600]}
      sizes="(min-width: 768px) 50vw, 100vw"
      class="hidden aspect-[4/5] h-full w-full object-cover md:block md:aspect-auto md:h-[85vh]"
    />
  </section>

  <section class="relative z-10 bg-[#DDDDD3] px-8 py-20 md:px-16 md:py-28 lg:px-20 lg:py-32">
    <div class="mx-auto max-w-[92rem]">
      <h2 class="font-founders text-step-6 font-light md:text-step-8" data-i18n="work.overviewTitle" data-fade-in>
        {t('work.overviewTitle')}
      </h2>
      <p
        class="font-founders mt-4 max-w-[36em] text-step-1 font-light md:text-step-3"
        data-i18n="work.overviewBody"
        data-fade-in
      >
        {t('work.overviewBody')}
      </p>

      <h2
        class="font-founders mt-24 text-step-6 font-light md:mt-32 md:text-step-8"
        data-i18n="work.benefitsTitle"
        data-fade-in
      >
        {t('work.benefitsTitle')}
      </h2>
      <div
        class="mt-10 hidden items-end gap-12 md:mt-16 md:grid md:grid-cols-[minmax(12rem,28%)_1fr] lg:grid-cols-[minmax(14rem,32%)_1fr]"
        data-fade-in
      >
        <p
          class="font-nunito text-right text-step--2 font-light tracking-[0.28em] uppercase"
          data-i18n="work.benefitsCol1"
        >
          {t('work.benefitsCol1')}
        </p>
        <p
          class="font-nunito text-step--2 font-light tracking-[0.28em] uppercase"
          data-i18n="work.benefitsCol2"
        >
          {t('work.benefitsCol2')}
        </p>
      </div>
      <div class="mt-8 flex flex-col gap-10 md:mt-12 md:gap-12">
        {
          benefits.map((item, index) => (
            <div
              class="grid items-start gap-4 md:grid-cols-[minmax(12rem,28%)_1fr] md:gap-12 lg:grid-cols-[minmax(14rem,32%)_1fr]"
              data-fade-in
              style={`--fade-delay: ${index * 60}ms`}
            >
              <div class="flex items-center gap-5">
                <span class="hidden h-px flex-1 bg-charcoal/50 md:block"></span>
                <p
                  class="font-nunito shrink-0 text-right text-step--1 leading-tight font-light tracking-[0.28em] uppercase"
                  data-i18n={item.label}
                >
                  {t(item.label)}
                </p>
              </div>
              <p class="font-nunito max-w-[38rem] text-step--1 leading-[1.7] font-light" data-i18n={item.body}>
                {t(item.body)}
              </p>
            </div>
          ))
        }
      </div>

      <div class="mt-24 md:mt-32 md:grid md:grid-cols-[minmax(12rem,28%)_1fr] md:gap-12 lg:grid-cols-[minmax(14rem,32%)_1fr]">
        <div class="hidden md:block"></div>
        <div data-fade-in>
          <h2 class="font-founders text-step-6 font-light md:text-step-8" data-i18n="work.sessionTitle">
            {t('work.sessionTitle')}
          </h2>
          <p
            class="font-founders mt-4 max-w-[32em] text-step-1 font-light italic md:text-step-3"
            data-i18n="work.sessionIntro"
          >
            {t('work.sessionIntro')}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="pb-16 md:pb-20">
    <div class="flex flex-col gap-2">
      {
        steps.map((step) => (
          <div class="grid grid-cols-[minmax(6.5rem,38%)_1fr] items-center">
            <p
              class="font-nunito flex min-h-16 items-center justify-end px-3 py-3 text-right text-[10px] leading-tight font-light tracking-[0.18em] text-charcoal uppercase md:min-h-20 md:px-8 md:text-step--1 md:tracking-[0.4em]"
              style={`background: ${step.color}`}
              data-i18n={step.label}
            >
              {t(step.label)}
            </p>
            <div class="flex items-center gap-3 px-4 py-3 md:gap-6 md:px-10 md:py-5">
              <span class="hidden h-px w-8 shrink-0 bg-charcoal/35 sm:block md:w-16"></span>
              <p class="font-nunito max-w-[36rem] text-step--2 leading-[1.65] font-light md:text-step--1" data-i18n={step.body}>
                {t(step.body)}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="px-8 pb-24 md:px-16 md:pb-32 lg:px-20">
    <div class="mx-auto max-w-[92rem] md:grid md:grid-cols-[minmax(12rem,28%)_1fr] md:gap-12 lg:grid-cols-[minmax(14rem,32%)_1fr]">
      <div class="hidden md:block"></div>
      <div class="bg-[#E7E7E7]/60 px-8 py-8 md:px-10 md:py-10" data-fade-in>
        <h2
          class="font-founders text-step--1 font-medium tracking-[0.18em] uppercase"
          data-i18n="work.accessTitle"
        >
          {t('work.accessTitle')}
        </h2>
        <p
          class="font-nunito mt-4 max-w-[36rem] text-step--1 leading-[1.7] font-light"
          data-i18n="work.accessBody"
        >
          {t('work.accessBody')}
        </p>
      </div>
    </div>
  </section>

  <section class="px-8 pb-24 md:px-16 md:pb-32 lg:px-20">
    <div class="mx-auto max-w-[92rem]">
      <h2 class="font-founders text-step-6 font-light md:text-step-8" data-i18n="work.formatsTitle" data-fade-in>
        {t('work.formatsTitle')}
      </h2>
      <div class="mt-16 flex flex-col gap-10 md:mt-20 md:gap-12">
        {
          formats.map((item, index) => (
            <div
              class="grid items-start gap-4 md:grid-cols-[minmax(12rem,28%)_1fr] md:gap-12 lg:grid-cols-[minmax(14rem,32%)_1fr]"
              data-fade-in
              style={`--fade-delay: ${index * 60}ms`}
            >
              <div class="flex items-center gap-5">
                <span class="hidden h-px flex-1 bg-charcoal/50 md:block"></span>
                <p
                  class="font-nunito shrink-0 text-right text-step--1 leading-tight font-light tracking-[0.28em] uppercase"
                  data-i18n={item.label}
                >
                  {t(item.label)}
                </p>
              </div>
              <p class="font-nunito max-w-[38rem] text-step--1 leading-[1.7] font-light" data-i18n={item.body}>
                {t(item.body)}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="reserve" class="px-8 pt-4xl pb-24 md:px-16 md:pb-32 lg:px-20">
    <h2
      class="font-founders text-center text-step-6 font-light md:text-step-8"
      data-i18n="work.programTitle"
    >
      {t('work.programTitle')}
    </h2>
    <p
      class="font-founders mx-auto mt-4 max-w-[28em] text-center text-step-1 font-light italic md:text-step-3"
      data-i18n="work.programBody"
    >
      {t('work.programBody')}
    </p>
    <div class="mt-l">
      <CalendlyEmbed url={calendly} label={t('work.bookCta')} />
    </div>
  </section>
</article>
