---
import { Image } from 'astro:assets';
import { t } from '../i18n';
import footerPhoto from '../images/tf_footer_mytam.jpg';

const links = [
  { key: 'menu.itemTherapy', href: '/offers/dance-movement-therapy' },
  { key: 'menu.itemSomatics', href: '/offers/somatics-dance' },
  { key: 'menu.itemYoga', href: '/offers/somatic-yoga' },
] as const;
---

<footer id="footer">
  <section class="bg-charcoal text-paper px-8 py-4xl md:px-16">
    <div class="mx-auto" data-fade-in>
    <h2
      class="font-founder mx-auto max-w-[12em] text-center text-step-6 leading-[1.1] font-light md:text-step-9"
      data-i18n="footer.headline"
    >
      {t('footer.headline')}
    </h2>
    <p
      class="font-nunito mx-auto mt-m max-w-[34em] text-center text-[12px] leading-[1.65] font-light text-paper/80 md:text-step--1"
      data-i18n="footer.lede"
    >
      {t('footer.lede')}
    </p>
    </div>
  </section>

  <form
    class="bg-charcoal text-paper grid border-y border-white/20 md:grid-cols-[1.7fr_1fr]"
    data-newsletter
    data-signup-url={import.meta.env.PUBLIC_SIGNUP_URL}
  >
    <div class="md:border-r md:border-white/20">
      <label class="sr-only" for="newsletter-email" data-i18n="footer.emailPlaceholder">
        {t('footer.emailPlaceholder')}
      </label>
      <input
        id="newsletter-email"
        name="email"
        type="email"
        required
        autocomplete="email"
        placeholder={t('footer.emailPlaceholder')}
        data-i18n-placeholder="footer.emailPlaceholder"
        class="font-founder h-20 w-full bg-transparent px-6 text-center text-step-2 font-light tracking-[0.22em] text-paper placeholder:text-paper/70 focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-[-1px] focus-visible:outline-paper/40 md:h-24"
      />
    </div>
    <button
      type="submit"
      class="font-founder h-20 border-t border-white/20 text-step-1 font-light tracking-[0.35em] uppercase focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-[-1px] focus-visible:outline-paper/40 md:h-24 md:border-t-0"
      data-i18n="footer.signUp"
    >
      {t('footer.signUp')}
    </button>
    <p
      class="font-nunito col-span-full hidden border-t border-white/20 px-6 py-3 text-center text-step--1 font-light tracking-[0.18em] text-paper/80"
      data-newsletter-status
      aria-live="polite"
    >
    </p>
  </form>

  <section class="bg-sand text-charcoal px-8 pt-3xl pb-xl md:px-16 md:pt-4xl md:pb-2xl">
    <div class="grid items-end gap-12 lg:grid-cols-[1fr_auto] lg:gap-16" data-fade-in>
      <div class="flex min-h-[18rem] flex-col justify-between">
        <nav class="flex flex-col gap-s" aria-label="Footer">
          {
            links.map((link) => (
              <a
                href={link.href}
                class="font-nunito text-step-1 font-light tracking-[0.22em]"
                data-i18n={link.key}
              >
                {t(link.key)}
              </a>
            ))
          }
        </nav>

        <div class="mt-3xl flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <div>
            <p
              class="font-founders text-step-1 font-normal tracking-[0.22em] uppercase"
              data-i18n="footer.brand"
            >
              {t('footer.brand')}
            </p>
            <a
              href={`mailto:${t('footer.email')}`}
              class="font-nunito mt-2 block text-step--1 font-light tracking-[0.18em]"
              data-i18n="footer.email"
            >
              {t('footer.email')}
            </a>
          </div>
          <a
            href={`tel:${t('footer.phone').replace(/\s/g, '')}`}
            class="font-nunito text-step--1 font-light tracking-[0.18em]"
            data-i18n="footer.phone"
          >
            {t('footer.phone')}
          </a>
        </div>
      </div>

      <Image
        src={footerPhoto}
        alt={t('footer.photoAlt')}
        data-i18n-alt="footer.photoAlt"
        widths={[480, 720, 960]}
        sizes="(min-width: 1024px) 18rem, 80vw"
        class="h-[18rem] w-auto justify-self-end grayscale"
      />
    </div>
  </section>
</footer>

<script>
  import { t, type Lang } from '../i18n';

  const form = document.querySelector<HTMLFormElement>('[data-newsletter]');
  const signupUrl = form?.dataset.signupUrl;

  const lang = (): Lang => (document.documentElement.lang === 'fr' ? 'fr' : 'en');

  const setStatus = (key: string) => {
    const status = form?.querySelector<HTMLElement>('[data-newsletter-status]');
    if (!status) return;
    status.textContent = t(key, lang());
    status.classList.remove('hidden');
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !signupUrl) {
      setStatus('footer.signUpError');
      return;
    }

    const input = form.querySelector<HTMLInputElement>('input[type="email"]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const email = input?.value.trim();
    if (!input || !button || !email) return;

    button.disabled = true;

    try {
      const payload = new URLSearchParams({
        Date: new Date().toISOString(),
        Name: '',
        Email: email,
        Consent: 'Yes',
        Page: window.location.href,
      });

      const response = await fetch(`${signupUrl}?${payload.toString()}`);
      const result = await response.json().catch(() => null);
      if (!response.ok || result?.ok === false) {
        throw new Error('Signup failed');
      }
      if (result?.duplicate) {
        setStatus('footer.signUpExists');
      } else {
        input.value = '';
        setStatus('footer.signUpSuccess');
      }
    } catch {
      setStatus('footer.signUpError');
    } finally {
      button.disabled = false;
    }
  });
</script>
