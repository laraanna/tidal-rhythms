---
import { t } from '../i18n';

const calendlyUrl =
  'https://calendly.com/mayosmith-mytam/introduction-call?hide_gdpr_banner=1&background_color=ffffff&text_color=414141&primary_color=414141';
---

<section
  id="rdv"
  class="bg-mist text-charcoal px-8 py-4xl md:px-16 lg:px-20 lg:pt-24 lg:pb-44 xl:px-24"
>
  <div class="mx-auto w-full max-w-[92rem]">
    <div class="mx-auto flex max-w-[40rem] flex-col items-center gap-5 text-center" data-fade-in>
      <h2
        class="font-cormorant text-step-7 leading-[1.1] font-normal md:text-step-8"
        data-i18n="rdv.title"
      >
        {t('rdv.title')}
      </h2>
      <p
        class="font-nunito text-[12px] leading-[1.65] font-light md:text-step--1"
        data-i18n="rdv.body"
      >
        {t('rdv.body')}
      </p>
    </div>

    <div class="relative mt-2xl min-h-[43.75rem] overflow-hidden md:mt-0" data-calendly-wrap>
      <div
        class="calendly-inline-widget h-full min-h-[43.75rem] w-full shadow-none"
        data-url={calendlyUrl}
        role="region"
        aria-label={t('rdv.embedTitle')}
        data-i18n-aria-label="rdv.embedTitle"
        style="min-width: 320px; height: 700px; box-shadow: none"
      >
      </div>
      <div class="absolute inset-0 z-10" data-calendly-shield aria-hidden="true"></div>
    </div>
  </div>
</section>

<script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>

<style>
  [data-calendly-wrap] :global(iframe) {
    box-shadow: none !important;
    filter: none !important;
    outline: none !important;
    border: 0 !important;
  }
</style>

<script>
  const wrap = document.querySelector('[data-calendly-wrap]');
  const shield = document.querySelector<HTMLElement>('[data-calendly-shield]');

  if (wrap instanceof HTMLElement && shield) {
    const arm = () => {
      shield.style.pointerEvents = 'auto';
    };
    const disarm = () => {
      shield.style.pointerEvents = 'none';
    };

    shield.addEventListener('pointerdown', disarm);
    wrap.addEventListener('mouseleave', arm);
  }
</script>
