---
import { Image } from 'astro:assets';
import { t } from '../i18n';
import portrait from '../images/mytam_portrait.jpg';

const paragraphs = ['about.intro', 'about.p1', 'about.p2', 'about.p3'] as const;
---

<section
  id="about"
  class="bg-mist text-charcoal flex min-h-dvh items-center px-8 py-5xl md:px-16 lg:px-20"
>
  <div class="about-grid mx-auto grid w-full max-w-[92rem] gap-12">
    <h2
      class="about-title font-founders text-center text-step-0 leading-[1.75] font-light tracking-[0.3em] uppercase md:text-step-2 min-[1450px]:text-left"
      data-i18n-html="about.title"
      data-fade-in
      set:html={t('about.title')}
    />

    <div class="about-image justify-self-center" data-fade-in style="--fade-delay: 80ms">
      <Image
        src={portrait}
        alt={t('about.photoAlt')}
        data-i18n-alt="about.photoAlt"
        widths={[480, 720, 1080, 1400]}
        sizes="(min-width: 1024px) 28vw, 85vw"
        class="h-auto w-full max-w-[22rem] object-cover min-[1450px]:max-w-[26rem]"
      />
    </div>

    <div
      class="about-body flex w-full max-w-[22rem] flex-col mx-auto min-[1000px]:mx-0 min-[1000px]:max-w-none min-[1450px]:max-w-[26rem]"
      data-fade-in
      style="--fade-delay: 140ms"
    >
      <div class="flex flex-col gap-5 lg:gap-6">
        {
          paragraphs.map((key) => (
            <p
              class="font-nunito text-step-0 leading-[1.65] font-light"
              data-i18n={key}
            >
              {t(key)}
            </p>
          ))
        }
      </div>
      <button
        type="button"
        class="font-nunito mt-8 inline-flex w-fit border border-charcoal px-10 py-3 text-step--1 font-light tracking-[0.32em] uppercase lg:mt-10"
        data-trainings-open
        data-i18n="about.trainings"
        data-i18n-aria-label="about.trainingsOpenAria"
        aria-haspopup="dialog"
        aria-controls="trainings-title"
        aria-label={t('about.trainingsOpenAria')}
      >
        {t('about.trainings')}
      </button>
    </div>
  </div>
</section>

<style>
  .about-grid {
    grid-template-areas:
      'image'
      'title'
      'body';
  }

  .about-title {
    grid-area: title;
  }

  .about-image {
    grid-area: image;
  }

  .about-body {
    grid-area: body;
  }

  @media (min-width: 1000px) and (max-width: 1449.98px) {
    .about-grid {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas:
        'image body'
        'title body';
      align-items: start;
      column-gap: 3.5rem;
    }

    .about-body {
      align-self: center;
      padding-inline: 3.5rem;
    }
  }

  @media (min-width: 1450px) {
    .about-grid {
      grid-template-columns: 1fr auto 1fr;
      grid-template-areas: 'title image body';
      align-items: center;
      column-gap: 5rem;
    }
  }
</style>
