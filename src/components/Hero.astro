---
import { Image } from 'astro:assets';
import { t } from '../i18n';
import heroMobile from '../images/tf_hero_mytam_2.jpg';
// import heroMotion from '../images/hero_tf_mimi_2.jpg';
import heroMotion from '../images/movement_hero.jpg';
// import heroPortrait from '../images/hero_tf_mimi_1.jpg';
import heroPortrait from '../images/mimi_hero.jpg';
---

<section class="relative grid h-svh min-h-svh overflow-hidden bg-mist lg:grid-cols-2 lg:h-dvh lg:min-h-dvh">
  <div class="relative min-h-svh overflow-hidden lg:min-h-dvh">
    <Image
      src={heroMobile}
      alt={t('hero.mobileAlt')}
      data-i18n-alt="hero.mobileAlt"
      widths={[640, 960, 1280]}
      sizes="100vw"
      class="absolute inset-0 size-full object-cover object-center grayscale lg:hidden"
    />
    <Image
      src={heroMotion}
      alt={t('hero.motionAlt')}
      data-i18n-alt="hero.motionAlt"
      widths={[640, 960, 1280, 2000]}
      sizes="50vw"
      class="absolute inset-0 hidden size-full object-cover object-center grayscale lg:block"
    />

    <button
      type="button"
      class="font-nunito text-paper absolute top-7 right-6 z-10 flex items-center gap-2 text-sm tracking-[0.3em] uppercase lg:hidden"
      data-menu-open
      data-i18n-aria-label="hero.menuAria"
      aria-label={t('hero.menuAria')}
    >
      <span class="size-3 rounded-full bg-white"></span>
      <span data-i18n="hero.menu">{t('hero.menu')}</span>
    </button>

    <a href="/" class="absolute top-7 left-6 z-10 lg:top-8 lg:left-10">
      <span
        class="block font-founders text-[28px] md:text-[36px] font-regular leading-none tracking-[0.3em] uppercase"
        data-i18n="hero.logoTidal"
      >
        {t('hero.logoTidal')}
      </span>
      <span
        class="block font-founders text-[17px] md:text-[22px] font-light leading-none tracking-[0.3em] uppercase"
        data-i18n="hero.logoRhythms"
      >
        {t('hero.logoRhythms')}
      </span>
    </a>

    <div class="absolute bottom-[22%] left-10 right-8 z-10 md:left-14 lg:left-16 lg:right-10">
      <h1
        class="font-founders text-step-5 md:text-step-6 lg:text-step-8 leading-[1.15] font-normal tracking-[0.22em] text-paper uppercase"
      >
        <span data-i18n="hero.titleDance">{t('hero.titleDance')}</span>
        <span> </span>
        <span data-i18n="hero.titleAnd">{t('hero.titleAnd')}</span>
        <span class="hidden xl:inline"> </span>
        <br class="xl:hidden" />
        <span data-i18n="hero.titleMovement">{t('hero.titleMovement')}</span>
      </h1>
      <p
        class="font-cormorant mt-2 text-step-2 leading-none font-normal text-paper md:text-step-3"
        data-i18n="hero.byline"
      >
        {t('hero.byline')}
      </p>
    </div>

    <div class="absolute bottom-7 left-6 z-10 hidden lg:bottom-8 lg:left-10">
      <button
        type="button"
        class="font-nunito text-paper flex items-center gap-2 text-xl font-medium tracking-[0.3em] uppercase"
        data-lang-toggle
        aria-label={t('hero.langAriaEn')}
      >
        <span data-lang-label="en" class="opacity-80">EN</span>
        <span class="relative h-6 w-11 rounded-full bg-black/80 ring-1 ring-white/35" aria-hidden="true">
          <span
            data-lang-knob
            class="absolute top-0.5 left-0.5 size-5 rounded-full bg-white transition-transform duration-200"
          ></span>
        </span>
        <span data-lang-label="fr" class="opacity-35">FR</span>
      </button>
    </div>
  </div>

  <div class="relative hidden min-h-dvh overflow-hidden lg:block">
    <Image
      src={heroPortrait}
      alt={t('hero.floorAlt')}
      data-i18n-alt="hero.floorAlt"
      widths={[640, 960, 1280, 2000]}
      sizes="50vw"
      class="absolute inset-0 size-full object-cover object-[center_38%] grayscale"
    />

    <button
      type="button"
      class="font-nunito text-charcoal absolute top-8 right-10 z-10 flex items-center gap-2 text-xl tracking-[0.3em] font-normal uppercase"
      data-menu-open
      data-i18n-aria-label="hero.menuAria"
      aria-label={t('hero.menuAria')}
    >
      <span class="bg-charcoal size-3.5 rounded-full"></span>
      <span data-i18n="hero.menu">{t('hero.menu')}</span>
    </button>
  </div>
</section>
