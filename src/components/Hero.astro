---
import { Image } from 'astro:assets';
import { t } from '../i18n';
import heroMotion from '../images/tf_hero_mytam_2.jpg';
import heroFloor from '../images/tf_hero_mytam_1.jpg';
---

<section class="relative grid h-dvh min-h-dvh overflow-hidden bg-neutral-950 lg:grid-cols-2">
  <div class="relative min-h-dvh overflow-hidden">
    <Image
      src={heroMotion}
      alt={t('hero.motionAlt')}
      data-i18n-alt="hero.motionAlt"
      widths={[640, 960, 1280, 2000]}
      sizes="(min-width: 1024px) 50vw, 100vw"
      class="absolute inset-0 size-full object-cover object-[center_28%] lg:object-[center_58%]"
    />

    <button
      type="button"
      class="font-nunito text-paper absolute top-7 right-6 z-10 flex items-center gap-2 text-xl tracking-[0.3em] uppercase lg:hidden"
      data-menu-open
      data-i18n-aria-label="hero.menuAria"
      aria-label={t('hero.menuAria')}
    >
      <span class="size-3.5 rounded-full bg-white"></span>
      <span data-i18n="hero.menu">{t('hero.menu')}</span>
    </button>

    <a href="/" class="absolute top-7 left-6 z-10 lg:top-8 lg:left-10">
      <span
        class="block font-founders text-[1.05rem] font-medium leading-none tracking-[0.42em] uppercase"
        data-i18n="hero.logoTidal"
      >
        {t('hero.logoTidal')}
      </span>
      <span
        class="mt-1.5 block font-founders text-[0.62rem] font-light leading-none tracking-[0.62em] uppercase"
        data-i18n="hero.logoRhythms"
      >
        {t('hero.logoRhythms')}
      </span>
    </a>

    <div class="absolute top-[46%] left-6 z-10 -translate-y-1/2 lg:top-[52%] lg:left-10">
      <h1
        class="font-founders text-step-7 font-normal tracking-[0.18em] text-paper uppercase"
      >
        <span data-i18n="hero.titleDance">{t('hero.titleDance')}</span><br class="lg:hidden" />
        <span class="hidden lg:inline"> </span><span data-i18n="hero.titleAnd">{t('hero.titleAnd')}</span><br class="lg:hidden" />
        <span class="hidden lg:inline"> </span><span data-i18n="hero.titleMovement">{t('hero.titleMovement')}</span>
      </h1>
      <p
        class="font-cormorant text-step-3 font-normal text-paper"
        data-i18n="hero.byline"
      >
        {t('hero.byline')}
      </p>
    </div>

    <div class="absolute bottom-7 left-6 z-10 lg:bottom-8 lg:left-10">
      <button
        type="button"
        class="font-founders flex items-center gap-2.5 text-[0.6rem] font-light tracking-[0.28em] uppercase"
        data-lang-toggle
        aria-label={t('hero.langAriaEn')}
      >
        <span data-lang-label="en" class="opacity-80">EN</span>
        <span class="relative h-4 w-8 rounded-full bg-black/80 ring-1 ring-white/35" aria-hidden="true">
          <span
            data-lang-knob
            class="absolute top-0.5 left-0.5 size-3 rounded-full bg-white transition-transform duration-200"
          ></span>
        </span>
        <span data-lang-label="fr" class="opacity-35">FR</span>
      </button>
    </div>
  </div>

  <div class="relative hidden min-h-dvh overflow-hidden lg:block">
    <Image
      src={heroFloor}
      alt={t('hero.floorAlt')}
      data-i18n-alt="hero.floorAlt"
      widths={[640, 960, 1280, 2000]}
      sizes="50vw"
      class="absolute inset-0 size-full object-cover object-[center_42%]"
    />

    <button
      type="button"
      class="font-nunito absolute top-8 right-10 z-10 flex items-center gap-2 text-xl tracking-[0.3em] font-normal uppercase"
      data-menu-open
      data-i18n-aria-label="hero.menuAria"
      aria-label={t('hero.menuAria')}
    >
      <span class="size-3.5 rounded-full bg-white"></span>
      <span data-i18n="hero.menu">{t('hero.menu')}</span>
    </button>

    <aside
      class="absolute right-8 bottom-8 z-10 w-[15.5rem] bg-black/75 px-4 py-3.5 text-white backdrop-blur-[2px]"
      data-contact-card
    >
      <div class="flex items-start justify-between gap-3">
        <p
          class="font-founders text-[0.68rem] leading-[1.35] font-light tracking-[0.2em] uppercase"
          data-i18n-html="hero.contactHeading"
          set:html={t('hero.contactHeading')}
        />
        <button
          type="button"
          class="mt-0.5 text-[0.8rem] leading-none text-white/80"
          data-contact-close
          data-i18n-aria-label="hero.contactCloseAria"
          aria-label={t('hero.contactCloseAria')}
        >
          ×
        </button>
      </div>
      <p class="font-founders mt-5 text-[0.68rem] font-light tracking-wide" data-i18n="hero.contactPhone">
        {t('hero.contactPhone')}
      </p>
      <a
        href={`mailto:${t('hero.contactEmail')}`}
        class="font-founders mt-1 block text-[0.62rem] font-light tracking-wide text-white"
        data-i18n="hero.contactEmail"
      >
        {t('hero.contactEmail')}
      </a>
    </aside>
  </div>
</section>

<script>
  document.querySelector('[data-contact-close]')?.addEventListener('click', () => {
    document.querySelector('[data-contact-card]')?.classList.add('hidden');
  });
</script>
