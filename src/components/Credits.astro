---
import { t } from '../i18n';
---

<div
  class="pointer-events-none fixed inset-0 z-[450] flex items-center justify-center overflow-hidden p-4"
  data-credits
  aria-hidden="true"
>
  <div
    class="absolute inset-0 bg-black/70"
    data-credits-overlay
    data-credits-close
  >
  </div>

  <aside
    class="bg-sand text-charcoal relative z-10 flex max-h-[min(80dvh,36rem)] w-full max-w-[32rem] flex-col overflow-hidden outline-none"
    data-credits-panel
    data-lenis-prevent
    role="dialog"
    aria-modal="true"
    aria-labelledby="credits-title"
    tabindex="-1"
  >
    <button
      type="button"
      class="font-nunito absolute top-5 right-5 z-10 text-sm tracking-[0.28em] uppercase"
      data-credits-close
      data-i18n="menu.close"
      data-i18n-aria-label="menu.closeAria"
      aria-label={t('menu.closeAria')}
    >
      {t('menu.close')}
    </button>

    <div class="min-h-0 flex-1 overflow-y-auto px-8 py-12 md:px-10 md:py-14">
      <h2
        id="credits-title"
        class="font-founders text-step-2 font-light tracking-[0.18em] uppercase"
        data-i18n="footer.credits"
      >
        {t('footer.credits')}
      </h2>

      <h3
        class="font-nunito mt-8 text-step--2 font-light tracking-[0.28em] uppercase"
        data-i18n="footer.creditsPhotography"
      >
        {t('footer.creditsPhotography')}
      </h3>
      <div
        class="credits-list font-nunito mt-3 text-step--1 font-light leading-[1.65]"
        data-i18n-html="footer.creditsList"
        set:html={t('footer.creditsList')}
      />
    </div>
  </aside>
</div>

<style>
  [data-credits]:not(.is-open) {
    visibility: hidden;
  }

  [data-credits].is-open {
    pointer-events: auto;
    visibility: visible;
  }

  [data-credits-overlay] {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  [data-credits].is-open [data-credits-overlay] {
    opacity: 1;
  }

  [data-credits-panel] {
    transform: translate3d(0, 0.75rem, 0);
    opacity: 0;
    transition:
      transform 0.3s ease-out,
      opacity 0.3s ease-out;
  }

  [data-credits].is-open [data-credits-panel] {
    transform: none;
    opacity: 1;
  }

  .credits-list :global(li) {
    margin-top: 0.35rem;
    margin-bottom: 0.35rem;
  }

  .credits-list :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
</style>

<script>
  import { initCredits } from '../scripts/credits';
  initCredits();
</script>
