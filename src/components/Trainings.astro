---
import { t } from '../i18n';

const faqs = [
  { q: 'faq.q1', a: 'faq.a1' },
  { q: 'faq.q2', a: 'faq.a2' },
  { q: 'faq.q3', a: 'faq.a3' },
  { q: 'faq.q4', a: 'faq.a4' },
  { q: 'faq.q5', a: 'faq.a5' },
] as const;
---

<div
  class="pointer-events-none fixed inset-0 z-[450] overflow-clip"
  data-trainings
  aria-hidden="true"
>
  <div
    class="absolute inset-0 bg-black/70"
    data-trainings-overlay
    data-trainings-close
  >
  </div>

  <aside
    class="bg-charcoal text-paper absolute top-0 right-0 flex h-dvh w-full flex-col overflow-hidden outline-none lg:w-[65vw] lg:overflow-visible xl:w-[45vw]"
    data-trainings-panel
    data-lenis-prevent
    role="dialog"
    aria-modal="true"
    aria-labelledby="trainings-title"
    tabindex="-1"
  >
    <button
      type="button"
      class="font-nunito absolute top-6 right-6 z-10 text-sm tracking-[0.28em] uppercase lg:top-1/2 lg:right-auto lg:-left-10 lg:flex lg:size-20 lg:-translate-y-1/2 lg:items-center lg:justify-center lg:rounded-full lg:border lg:border-paper lg:bg-charcoal lg:text-[0.7rem]"
      data-trainings-close
      data-i18n="menu.close"
      data-i18n-aria-label="menu.closeAria"
      aria-label={t('menu.closeAria')}
    >
      {t('menu.close')}
    </button>

    <div class="min-h-0 flex-1 overflow-y-auto px-8 py-16 md:px-12 lg:px-16 lg:pt-20 lg:pr-16 lg:pb-24 lg:pl-20">
      <h2
        id="trainings-title"
        class="font-cormorant text-step-4 font-light md:text-step-5"
        data-i18n="about.trainingsTitle"
      >
        {t('about.trainingsTitle')}
      </h2>

      <div
        class="trainings-list font-nunito mt-8 max-w-[36rem] text-step-0 font-light leading-[1.65]"
        data-trainings-list
        data-i18n-html="about.trainingsList"
        set:html={t('about.trainingsList')}
      />

      <section class="mt-16 max-w-[36rem] pb-8">
        <h3
          class="font-cormorant text-step-4 font-light md:text-step-5"
          data-i18n="faq.title"
        >
          {t('faq.title')}
        </h3>
        <div class="mt-8">
          {
            faqs.map((item) => (
              <details class="faq-item">
                <summary>
                  <span data-i18n={item.q}>{t(item.q)}</span>
                </summary>
                <p
                  class="font-nunito pt-1 pb-5 text-[12px] leading-[1.65] font-light text-paper/85"
                  data-i18n={item.a}
                >
                  {t(item.a)}
                </p>
              </details>
            ))
          }
        </div>
      </section>
    </div>
  </aside>
</div>

<style>
  [data-trainings].is-open {
    pointer-events: auto;
  }

  [data-trainings-overlay] {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  [data-trainings].is-open [data-trainings-overlay] {
    opacity: 1;
    visibility: visible;
  }

  [data-trainings-panel] {
    transform: translate3d(100%, 0, 0);
    transition: transform 0.3s ease-out;
  }

  @media (min-width: 1024px) {
    [data-trainings-panel] {
      transform: translate3d(calc(100% + 2.5rem), 0, 0);
    }
  }

  [data-trainings].is-open [data-trainings-panel] {
    transform: translate3d(0, 0, 0);
  }

  [data-trainings-panel] [data-trainings-close] {
    visibility: hidden;
  }

  [data-trainings].is-open [data-trainings-panel] [data-trainings-close] {
    visibility: visible;
  }

  .trainings-list :global(li) {
    margin-top: 0.9rem;
    margin-bottom: 0.9rem;
  }

  .trainings-list :global(span) {
    display: block;
    margin-top: 0.15rem;
    font-size: var(--step--2);
    font-weight: 300;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .trainings-list :global(a) {
    font-style: italic;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .trainings-list :global(ul ul) {
    padding-left: 1.25rem;
    list-style-type: circle;
  }

  .trainings-list :global(ul ul li) {
    margin-top: 0.4rem;
    margin-bottom: 0.4rem;
  }

  .trainings-list :global(p) {
    margin-bottom: 0.3rem;
  }

  .faq-item {
    border-bottom: 1px solid rgb(254 254 254 / 0.28);
  }

  .faq-item summary {
    display: flex;
    cursor: pointer;
    list-style: none;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.15rem 0;
    font-family: var(--font-nunito);
    font-size: var(--step--2);
    font-weight: 300;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1.45;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: '+';
    flex-shrink: 0;
    font-size: 1.1em;
    line-height: 1;
  }

  .faq-item[open] summary::after {
    content: '−';
  }
</style>
