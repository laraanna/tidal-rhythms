---
import { t } from '../i18n';
import heroVideo from '../videos/3E1A0315.mov?url';
---

<section class="relative flex h-[55svh] min-h-[18rem] items-center justify-center overflow-hidden bg-black md:h-dvh md:min-h-dvh" id="video">
  <video
    class="absolute inset-0 size-full object-cover"
    src={heroVideo}
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    aria-hidden="true"
    data-hero-video
  ></video>
  <div class="absolute inset-0 bg-black/25"></div>
  <p
    class="font-founder relative z-10 px-8 text-center text-step-6 font-light tracking-[0.05em] md:text-[5em] text-mist/70"
    data-i18n="video.overlay"
    data-fade-in
  >
    {t('video.overlay')}
  </p>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (video) {
    video.muted = true;
    video.play().catch(() => {});
  }
</script>
