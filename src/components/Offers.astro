---
import { Image } from 'astro:assets';
import { t } from '../i18n';
import offerA from '../images/offer_A.jpg';
import offerB from '../images/offer_B.jpg';
import offerC from '../images/offer_C.jpg';

const offers = [
  {
    id: 'dance-movement-therapy',
    titleKey: 'menu.itemTherapy',
    eyebrowKey: 'offers.therapy.eyebrow',
    blurbKey: 'offers.therapy.blurb',
    image: offerA,
  },
  {
    id: 'somatics-dance',
    titleKey: 'menu.itemSomatics',
    eyebrowKey: 'offers.somatics.eyebrow',
    blurbKey: 'offers.somatics.blurb',
    image: offerB,
  },
  {
    id: 'somatic-yoga',
    titleKey: 'menu.itemYoga',
    eyebrowKey: 'offers.yoga.eyebrow',
    blurbKey: 'offers.yoga.blurb',
    image: offerC,
  },
] as const;
---

<section class="lg:grid lg:grid-cols-3" aria-label="Offers">
  {
    offers.map((offer, index) => (
      <article
        id={offer.id}
        class="text-charcoal relative flex flex-col overflow-hidden px-10 py-12 md:px-12 md:py-14 lg:aspect-[4/5] lg:px-14 lg:pt-16 lg:pb-20"
      >
        <Image
          src={offer.image}
          alt=""
          widths={[720, 1100, 1600]}
          sizes="(min-width: 1024px) 33vw, 100vw"
          class="absolute inset-0 size-full object-cover"
          aria-hidden="true"
        />
        <div
          class="relative z-10 flex min-h-full flex-1 flex-col"
          data-fade-in
          style={`--fade-delay: ${index * 90}ms`}
        >
          <p
            class="mt-5 font-founder text-step-3 md:text-step-3 xl:text-step-5 font-light text-charcoal/75"
            data-i18n={offer.eyebrowKey}
          >
            {t(offer.eyebrowKey)}
          </p>

          <h2 class="font-founders mt-8 text-step-4 md:text-step-5 leading-[1.15] font-light lg:max-w-[5.2em] xl:text-step-7">
            <a href={`/offers/${offer.id}`} data-i18n={offer.titleKey}>
              {t(offer.titleKey)}
            </a>
          </h2>
          <p
            class="font-founder mt-5 max-w-[16em] text-step-0 md:text-step-1 xl:text-step-2 font-light tracking-[0.1em] uppercase lg:mt-8 lg:max-w-[70%]"
            data-i18n={offer.blurbKey}
          >
            {t(offer.blurbKey)}
          </p>

          <a
            href={`/offers/${offer.id}`}
            class="font-nunito text-paper mt-8 inline-flex w-fit border border-paper px-9 py-3.5 text-step--1 font-light tracking-[0.28em] uppercase lg:mt-auto lg:px-10"
            data-i18n="offers.reserve"
          >
            {t('offers.reserve')}
          </a>
        </div>
      </article>
    ))
  }
</section>
