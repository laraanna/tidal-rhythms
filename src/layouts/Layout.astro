---
import '../styles/global.css';
import { t } from '../i18n';
import Menu from '../components/Menu.astro';
import ContactCard from '../components/ContactCard.astro';
import Trainings from '../components/Trainings.astro';

interface Props {
  titleKey?: string;
  showContact?: boolean;
}

const { titleKey = 'meta.title', showContact = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t('meta.description')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap"
      rel="stylesheet"
    />
    <title data-i18n={titleKey}>{t(titleKey)}</title>
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body class="antialiased">
    <Menu />
    <Trainings />
    {showContact && <ContactCard />}
    <slot />
  </body>
</html>

<script>
  import { initI18n } from '../scripts/i18n';
  import { initMenu } from '../scripts/menu';
  import { initTrainings } from '../scripts/trainings';
  import { initLenis } from '../scripts/lenis';
  import { initFadeIn } from '../scripts/fade';
  import { initCursor } from '../scripts/cursor';
  initLenis();
  initI18n();
  initMenu();
  initTrainings();
  initFadeIn();
  initCursor();
</script>
