---
import '../styles/global.css';
import { t } from '../i18n';
import Menu from '../components/Menu.astro';
import ContactCard from '../components/ContactCard.astro';
import Trainings from '../components/Trainings.astro';
import Credits from '../components/Credits.astro';
import LangSwitch from '../components/LangSwitch.astro';

interface Props {
  titleKey?: string;
  showContact?: boolean;
}

const { titleKey = 'meta.title', showContact = true } = Astro.props;
const title = t(titleKey);
const description = t('meta.description');
const origin = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, origin).href;
const ogImage = new URL('/web-app-manifest-512x512.png', origin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tidal Rhythms" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="Tidal Rhythms" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#414141" />
    <meta name="apple-mobile-web-app-title" content="Tidal Rhythms" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap"
      rel="stylesheet"
    />
    <title data-i18n={titleKey}>{title}</title>
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body class="antialiased">
    <Menu />
    <Trainings />
    <Credits />
    {showContact && <ContactCard />}
    <LangSwitch />
    <slot />
  </body>
</html>

<script>
  import { initI18n } from '../scripts/i18n';
  import { initMenu } from '../scripts/menu';
  import { initTrainings } from '../scripts/trainings';
  import { initLenis } from '../scripts/lenis';
  import { initFadeIn } from '../scripts/fade';
  import { initCursor } from '../scripts/cursor';
  initLenis();
  initI18n();
  initMenu();
  initTrainings();
  initFadeIn();
  initCursor();
</script>
